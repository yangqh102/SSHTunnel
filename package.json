{
  "name": "local-overleaf",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.localoverleaf.app",
    "productName": "LocalOverleaf",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/app-icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "arch": ["arm64"],
      "icon": "assets/app-icon.icns",
      "skipNotarization": true,
      "skipSign": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "node_modules/ssh2/**/*.node",
      "node_modules/ssh2/lib/**/*"
    ],
    "extraFiles": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "npmRebuild": true,
    "buildDependenciesFromSource": true
  },
  "dependencies": {
    "install": "^0.13.0",
    "path": "^0.12.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0"
  }
}
