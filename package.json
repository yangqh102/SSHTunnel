{
  "name": "local-overleaf",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-rebuild && electron-builder --mac",
    "build:all": "electron-builder --win --mac --linux",
    "rebuild": "electron-rebuild -f -w ssh2"
  },
  "build": {
    "appId": "com.localoverleaf.app",
    "productName": "LocalOverleaf",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/app-icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/app-icon.icns",
      "category": "Utility",
      "hardenedRuntime": false
    },
    "files": [
      "**/*",
      "!node_modules/ssh2/build/**"
    ],
    "asarUnpack": [
      "node_modules/ssh2/**/*.node"
    ],
    "extraFiles": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": true
  },
  "dependencies": {
    "install": "^0.13.0",
    "path": "^0.12.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-rebuild": "^3.2.9"
  }
}