{
  "name": "local-overleaf",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.localoverleaf.app",
    "productName": "LocalOverleaf",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/app-icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/app-icon.icns",
      "category": "Utility"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ]
  },
  "dependencies": {
    "electron": "^39.2.7",
    "install": "^0.13.0",
    "path": "^0.12.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron-builder": "^26.4.0"
  }
}
